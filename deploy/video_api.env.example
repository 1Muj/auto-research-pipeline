# Copy this file to deploy/video_api.env and fill only the providers you want to use.
# The MVP runs without any API key; empty values mean heuristic/local placeholder mode.

# 1) LLM for slide builder + judge agent.
# Preferred for the current Lumid/Qwen demo.
LUM_API_KEY=
LUMID_BASE_URL=https://lum.id/llm/v1
LUMID_MODEL=qwen3.6-27b
LUMID_OMNI_MODEL=qwen-omni
LUMID_IMAGE_MODEL=qwen-image
LUMID_TTS_MODEL=qwen-tts
LUMID_TTS_VOICE=default

# Optional comparison model: DeepSeek's OpenAI-compatible chat/completions API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Fallback: any OpenAI-compatible chat/completions endpoint is still supported.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://lum.id/llm/v1
OPENAI_MODEL=qwen3.6-27b

# Renderer style: arbor or classic.
AUTO_VIDEO_RENDER_STYLE=scene
AUTO_VIDEO_API_TIMEOUT=90
AUTO_VIDEO_IMAGE_TIMEOUT=180
AUTO_VIDEO_TTS_TIMEOUT=120
AUTO_VIDEO_TTS_TEMPO=0.90
AUTO_VIDEO_PRE_SPEECH_HOLD_SEC=0.35
AUTO_VIDEO_POST_SPEECH_HOLD_SEC=1.20
AUTO_VIDEO_TTS_WORKERS=2
AUTO_VIDEO_SOURCE_CHARS=16000
AUTO_VIDEO_JUDGE_SLIDE_CHARS=12000
AUTO_VIDEO_JUDGE_SUBTITLE_CHARS=8000
AUTO_VIDEO_REVISE_SLIDE_CHARS=12000
AUTO_VIDEO_USE_SCENE_DIRECTOR=1

# 1b) Optional VLM for cursor grounding.
# Use a vision-capable OpenAI-compatible model. If empty, falls back to OPENAI_*.
# For a temporary all-Lumid/Qwen demo, you may also fill these with Lumid;
# unsupported vision calls will fall back to heuristic cursor grounding.
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=https://lum.id/llm/v1
OPENAI_VISION_MODEL=qwen-omni

# 2) Optional qwen-tts provider.
AUTO_VIDEO_TTS_PROVIDER=lumid-qwen-tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 3) Optional talking-head provider.
# Leave empty for local placeholder mode, or set AUTO_VIDEO_TALKING_HEAD_PROVIDER=lumid-qwen-placeholder
# to show the API slot is enabled while waiting for a real talking-head/video provider.
AUTO_VIDEO_TALKING_HEAD_PROVIDER=
HEYGEN_API_KEY=
D_ID_API_KEY=
AUTO_VIDEO_VOICE_SAMPLE=
AUTO_VIDEO_PORTRAIT=

# 4) Optional FlowMesh endpoint/token.
# Use this when Junyi's FlowMesh workflow examples are ready to accept a submitted DAG.
FLOWMESH_API_URL=
FLOWMESH_API_TOKEN=
FLOWMESH_WORKSPACE=
