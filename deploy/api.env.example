# =============================================================================
# API / 密钥占位 — 复制为 deploy/api.env 后填写（deploy/api.env 已在 .gitignore，勿提交）
#   cp deploy/api.env.example deploy/api.env
# 使用前加载（当前终端会话）：
#   source scripts/load_api_env.sh
# =============================================================================

# --- Claude / Anthropic（流水线里可选 LLM 反馈：需 pip install -e ".[anthropic]"）---
ANTHROPIC_API_KEY=
# 若走企业网关 / 代理，填 base URL（实现以 anthropic SDK 为准）
ANTHROPIC_BASE_URL=

# --- OpenAI 兼容 Chat Completions（agent --llm 可用，无需 anthropic 包）---
OPENAI_API_KEY=
# 留空则默认 https://api.openai.com/v1；第三方兼容网关填其 /v1 前缀 URL
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# 若同时配置了 ANTHROPIC 与 OPENAI，默认优先 Anthropic；设为 openai 可强制走 OpenAI
# AUTO_RESEARCH_LLM_PROVIDER=openai

# --- 预留：通用 HTTP 网关（自定义推理服务时可填）---
CUSTOM_INFERENCE_URL=
CUSTOM_INFERENCE_API_KEY=

# --- Vast.ai（租 GPU；与 vastai CLI 配合：有 VAST_API_KEY 时可 `vastai set api-key "$VAST_API_KEY"`）---
VAST_API_KEY=
VAST_GPU_QUERY=gpu_name=RTX_5080 num_gpus=1
VAST_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
VAST_DISK_GB=64
# 已知 offer id 时可填，跳过 search
# VAST_OFFER_ID=

# --- Vast 已租实例：本地代码直传，不经过 GitHub ---
# 复制 Vast 页面里的 SSH 命令，例如：ssh -p 12345 root@23.158.136.85
VAST_SSH_CMD=
VAST_REMOTE_DIR=/root/auto-research
VAST_EXPERIMENT=experiments/_demo_mnist_cnn.yaml

# --- GitHub（注册 self-hosted runner 时用的短期 token，勿长期写死）---
GITHUB_TOKEN=
